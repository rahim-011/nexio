datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



//Enums

enum ResourceTypes {
  video
  image
}

enum RequestStatuses {
  pending
  rejected
  accepted
}




//Models

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  username      String    @unique
  emailVerified Boolean
  image         String?
  bio           String?
  friendsIds    String[]    @db.ObjectId
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  posts          Post[]
  messages      Message[]
  otpCodes      OtpCodes[]
  sentRequests  Requests[]      @relation("SentRequests")
  receivedRequests  Requests[]  @relation("ReceivedRequests")
  @@map("user")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt    DateTime
  token        String   @unique
  createdAt    DateTime
  updatedAt    DateTime
  ipAddress    String?
  userAgent    String?
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}





type Media{
  publicId String
  resourceType ResourceTypes
  url   String
}
model Post{
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  caption    String?
  media      Media
  userId     String     @db.ObjectId
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId],references: [id],onDelete:Cascade)
}

model Chat{
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  participants String[]  @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    Message[]
}


model Message{
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  chatId  String   @db.ObjectId
  senderId  String @db.ObjectId
  content   String
  receivedAt  DateTime?
  hasReceived Boolean   @default(false) 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender     User   @relation(fields: [senderId], references: [id],onDelete:Cascade)
  chat       Chat   @relation(fields: [chatId],references: [id],onDelete:Cascade)
  @@index([chatId,createdAt]) // index for inhancing the query of getting the messages
}



model OtpCodes{
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  hashedOtpCode     String
  userId      String    @db.ObjectId
  expiredAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id],onDelete:Cascade)
}


model Requests{
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  senderId    String    @db.ObjectId
  receiverId  String    @db.ObjectId
  status      RequestStatuses   @default(pending)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender      User      @relation("SentRequests",fields: [senderId],references: [id],onDelete:Cascade)
  receiver      User      @relation("ReceivedRequests",fields: [receiverId],references: [id],onDelete:Cascade)

  @@index([receiverId,status]) //Here to inhance the search of that speceific receiver of this request
  @@unique([senderId,receiverId]) //receiver cant send back a request to the sender
}